{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-rich",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFOpJjrkemn-gauB",
    "TURNSTILE_HOSTNAMES": "superrich.tech,www.superrich.tech,localhost,127.0.0.1"
  }
}
