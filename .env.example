# Neon PostgreSQL (Free Tier - https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Upstash Redis (Free Tier - https://upstash.com)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Admin Authentication (Simple username & password for admin panel)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password
ADMIN_JWT_SECRET=super_secret_random_key_min_32_characters_long

# Free APIs for Data Fetching
FINNHUB_API_KEY=your_free_finnhub_key # https://finnhub.io
TWELVE_DATA_API_KEY=your_free_twelve_data_key # https://twelvedata.com
GEMINI_API_KEY=your_gemini_api_key # Free tier for translation & extraction

# Grokipedia API (xAI's Grokipedia Unofficial REST API)
# Uses https://github.com/jasonniebauer/grokipedia-api (default: https://grokipedia-api.com)
GROKIPEDIA_API_BASE_URL=https://grokipedia-api.com
GROKIPEDIA_API_KEY=
